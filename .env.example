# Zotero Web API credentials: https://www.zotero.org/settings/keys
# (key needs library read + write access; LIBRARY_ID is the numeric "userID" shown on that page)
ZOTERO_LIBRARY_ID=
# user | group
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=

# Optional: OpenReview login (its API blocks anonymous access; needed for ICLR / NeurIPS scans)
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Optional: higher rate limits
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
NCBI_API_KEY=
# Optional: sent as mailto= to the OpenAlex / Crossref polite pools
CONTACT_EMAIL=
# Optional LLM provider keys (config.yaml -> llm.provider)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
